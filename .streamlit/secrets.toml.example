# Copy these settings to .streamlit/secrets.toml and replace the placeholders.
# Never commit the real secrets.toml file.

GEMINI_API_KEY = "your-gemini-api-key-here"

# From your Twilio Console (console.twilio.com):
TWILIO_ACCOUNT_SID = "your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token-here"

# Twilio's shared WhatsApp Sandbox sender.
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# Content template SID from Twilio's Content Template Builder.
TWILIO_CONTENT_SID = "your-content-template-sid-here"
